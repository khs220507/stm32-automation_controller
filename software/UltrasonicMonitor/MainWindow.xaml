<Window x:Class="UltrasonicMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="STM32 통신 시험 대시보드"
        Width="1180" Height="820" MinWidth="1000" MinHeight="740"
        Background="#F3F6F8" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="LogStyle" TargetType="ListBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="#101820" />
            <Setter Property="Foreground" Value="#D9E7EE" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D8E0E5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Malgun Gothic" />
        </Style>
        <Style x:Key="TestResultStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Malgun Gothic" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="#52616B" />
            <Setter Property="MinHeight" Value="74" />
            <Setter Property="Margin" Value="0,14,0,4" />
        </Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock FontSize="25" FontWeight="SemiBold" Text="STM32 통신 시험 대시보드" />
                <TextBlock Margin="0,4,0,0" Foreground="#5F6B73"
                           Text="두 센서의 반복 시험을 각각 시작하고 정지할 수 있습니다." />
            </StackPanel>
            <Border DockPanel.Dock="Right" VerticalAlignment="Center" Padding="12,6" CornerRadius="14" Background="#E7EEF2">
                <TextBlock x:Name="ConnectionStatusText" FontWeight="SemiBold" Foreground="#52616B" Text="연결 안 됨" />
            </Border>
        </DockPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Text="COM 포트" />
                <ComboBox x:Name="PortComboBox" DockPanel.Dock="Left" Width="150" Height="34" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                <Button DockPanel.Dock="Left" Click="RefreshPorts_Click" Content="새로 고침" />
                <Button x:Name="ConnectButton" DockPanel.Dock="Left" Click="Connect_Click" Content="연결" />
            </DockPanel>
        </Border>
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="UART" />
                    <TextBlock Margin="0,4,0,0" Foreground="#687780" Text="USB · USART2 요청 / 응답" />
                    <TextBlock x:Name="UartStatusText" Style="{StaticResource TestResultStyle}" Text="확인 전" />
                    <TextBlock Foreground="#687780" Text="추가 센서 배선 없이 확인" />
                    <Button x:Name="UartCheckButton" Margin="0,18,0,12" HorizontalAlignment="Left"
                            Click="UartCheckButton_Click" Content="요청·응답 확인" IsEnabled="False" />
                    <TextBlock x:Name="UartLastCheckText" Foreground="#687780" Text="확인 이력 없음" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="I2C · MPU6050" />
                    <TextBlock Margin="0,4,0,0" Foreground="#687780" Text="식별 레지스터 확인" />
                    <TextBlock x:Name="MpuStatusText" Style="{StaticResource TestResultStyle}" Text="확인 전" />
                    <TextBlock x:Name="MpuIdentityText" Foreground="#687780" Text="식별값: — · 기대값: 0x68" TextWrapping="Wrap" />
                    <WrapPanel Margin="0,18,0,12">
                        <Button x:Name="MpuStartButton" Click="MpuStartButton_Click" Content="시작" IsEnabled="False" />
                        <Button x:Name="MpuStopButton" Click="MpuStopButton_Click" Content="정지" IsEnabled="False" />
                    </WrapPanel>
                    <TextBlock x:Name="MpuModeText" Foreground="#687780" Text="정지" />
                    <TextBlock x:Name="MpuLastCheckText" Foreground="#687780" Text="확인 이력 없음" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="19" FontWeight="SemiBold" Text="초음파 · HC-SR04" />
                    <TextBlock Margin="0,4,0,0" Foreground="#687780" Text="GPIO / 타이머 펄스 측정" />
                    <TextBlock x:Name="SensorStatusText" Style="{StaticResource TestResultStyle}" Text="확인 전" />
                    <WrapPanel>
                        <TextBlock Text="거리 " Foreground="#687780" />
                        <TextBlock x:Name="DistanceText" FontWeight="SemiBold" Text="—" />
                        <TextBlock Text=" cm    펄스 " Foreground="#687780" />
                        <TextBlock x:Name="PulseText" FontWeight="SemiBold" Text="—" />
                        <TextBlock Text=" µs" Foreground="#687780" />
                    </WrapPanel>
                    <WrapPanel Margin="0,18,0,12">
                        <Button x:Name="StartButton" Click="StartButton_Click" Content="시작" IsEnabled="False" />
                        <Button x:Name="StopButton" Click="StopButton_Click" Content="정지" IsEnabled="False" />
                    </WrapPanel>
                    <TextBlock x:Name="MeasurementModeText" Foreground="#687780" Text="정지" />
                    <TextBlock x:Name="SensorLastCheckText" Margin="0,4,0,0" Foreground="#687780" Text="확인 이력 없음" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="85" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="UART 로그" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="UartLogListBox" Style="{StaticResource LogStyle}" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="MPU6050 로그" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="MpuLogListBox" Style="{StaticResource LogStyle}" />
                    </DockPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="초음파 로그" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="UltrasonicLogListBox" Style="{StaticResource LogStyle}" />
                    </DockPanel>
                </Border>
            </Grid>
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" Text="연결 · 시스템 로그" />
                    </DockPanel>
                    <ListBox x:Name="LogListBox" Style="{StaticResource LogStyle}" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>